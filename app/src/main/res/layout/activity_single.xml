<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <!-- Kopfzeile mit Zurueck + Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#99000000">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kamera"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="12dp" />
    </LinearLayout>

    <!-- PTZ-Steuerung (nur sichtbar wenn Kamera PTZ hat) -->
    <LinearLayout
        android:id="@+id/ptz_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="#80000000"
        android:visibility="gone">

        <!-- Festpositionen -->
        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/preset_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Steuerkreuz -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView
                    android:layout_width="64dp"
                    android:layout_height="1dp" />
                <Button
                    android:id="@+id/ptz_up"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:text="▲"
                    android:textSize="22sp" />
                <TextView
                    android:layout_width="64dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <Button
                    android:id="@+id/ptz_left"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:text="◀"
                    android:textSize="22sp" />
                <Button
                    android:id="@+id/ptz_home"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:text="⌂"
                    android:textSize="22sp" />
                <Button
                    android:id="@+id/ptz_right"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:text="▶"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView
                    android:layout_width="64dp"
                    android:layout_height="1dp" />
                <Button
                    android:id="@+id/ptz_down"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:text="▼"
                    android:textSize="22sp" />
                <TextView
                    android:layout_width="64dp"
                    android:layout_height="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/ptz_zoom_in"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:text="+" />
                <Button
                    android:id="@+id/ptz_zoom_out"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:text="−" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
