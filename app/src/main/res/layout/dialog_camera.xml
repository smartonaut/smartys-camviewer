<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_name"
            android:textColor="@color/white" />
        <EditText
            android:id="@+id/in_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_name"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_source"
            android:textColor="@color/white" />
        <RadioGroup
            android:id="@+id/source_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rb_rtsp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_rtsp_url"
                android:checked="true" />
            <RadioButton
                android:id="@+id/rb_backend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_backend" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_rtsp_url"
            android:textColor="@color/white" />
        <EditText
            android:id="@+id/in_rtsp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_rtsp"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_backend_base"
            android:textColor="@color/white" />
        <EditText
            android:id="@+id/in_backend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_backend"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_cam_id"
            android:textColor="@color/white" />
        <EditText
            android:id="@+id/in_camid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_cam_id"
            android:inputType="text" />

        <!-- PTZ / Schwenken-Neigen-Zoom -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_ptz"
            android:textColor="@color/accent"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_ptz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cb_ptz"
            android:textColor="@color/white" />

        <EditText
            android:id="@+id/in_ptz_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ptz_host"
            android:inputType="text" />

        <EditText
            android:id="@+id/in_ptz_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ptz_port"
            android:inputType="number" />

        <EditText
            android:id="@+id/in_ptz_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ptz_user"
            android:inputType="text" />

        <EditText
            android:id="@+id/in_ptz_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_ptz_pass"
            android:inputType="textPassword" />
    </LinearLayout>
</ScrollView>
